/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "ipq5332-base.dtsi"

/ {
    model = "ipq5332-jdcloud-be6500";
    compatible = "qcom,ipq5332-jdcloud-be6500", "qcom,ipq5332";

    memory {
        reg = <0x0 0x0 0x0 0x40000000>; /* 1GB DDR4 */
    };

    chosen {
        bootargs = "console=ttyMSM0,115200n8 earlycon=msm_serial_dm,0x078af000";
    };

    aliases {
        led-boot = &led_power;
        led-failsafe = &led_power;
        led-running = &led_power;
        led-upgrade = &led_power;
    };

    leds {
        compatible = "gpio-leds";

        led_power: power {
            label = "be6500:green:power";
            gpio = <&tlmm 32 GPIO_ACTIVE_LOW>;
            default-state = "on";
        };

        led_wifi_2g: wifi-2g {
            label = "be6500:blue:wifi-2g";
            gpio = <&tlmm 33 GPIO_ACTIVE_LOW>;
            default-state = "off";
        };

        led_wifi_5g: wifi-5g {
            label = "be6500:blue:wifi-5g";
            gpio = <&tlmm 34 GPIO_ACTIVE_LOW>;
            default-state = "off";
        };

        led_joy: joy {
            label = "be6500:rgb:joy";
            gpio = <&tlmm 35 GPIO_ACTIVE_LOW>;
            default-state = "off";
        };
    };

    buttons {
        compatible = "gpio-keys";
        #address-cells = <1>;
        #size-cells = <0>;

        reset {
            label = "Reset";
            gpios = <&tlmm 26 GPIO_ACTIVE_LOW>;
            linux,code = <KEY_RESTART>;
            debounce-interval = <200>;
        };

        joy {
            label = "Joy";
            gpios = <&tlmm 27 GPIO_ACTIVE_LOW>;
            linux,code = <KEY_PROG1>;
            debounce-interval = <200>;
        };
    };

    usb {
        compatible = "qcom,ipq5332-usb";
        reg = <0x08800000 0x10000>;
        interrupts = <0 37 4>;
        clocks = <&clock 13>;
        clock-names = "usb";
        status = "okay";
    };

    ethernet@8000000 {
        compatible = "qcom,ipq5332-gmac";
        reg = <0x8000000 0x10000>;
        interrupts = <0 24 4>;
        qcom,phy-handle = <&phy>;
        status = "okay";
    };

    mdio@8000000 {
        compatible = "qcom,ipq5332-mdio";
        reg = <0x8000000 0x10000>;
        #address-cells = <1>;
        #size-cells = <0>;

        phy: ethernet-phy@0 {
            reg = <0>;
            compatible = "ethernet-phy-ieee802.3-c22";
        };
    };

    pcie: pcie@10000000 {
        compatible = "qcom,ipq5332-pcie";
        reg = <0x10000000 0x1000000>;
        interrupts = <0 43 4>;
        clocks = <&clock 24>;
        clock-names = "pcie";
        status = "okay";
        qcn6224: wifi@0,0 {
            compatible = "qcom,ath11k";
            reg = <0 0 0 0x1000>;
            status = "okay";
            device_type = "wifi";
            interrupt-parent = <&pcie>;
            interrupts = <0 43 4>;
            qcom,chip-id = <0x6224>;
        };
    };
};
